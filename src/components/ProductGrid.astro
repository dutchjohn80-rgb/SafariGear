---
const { products } = Astro.props;
---
<section id="products" class="mx-auto max-w-7xl scroll-mt-28 px-5 pb-28">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-400">Featured gear</p>
      <h2 class="font-display mt-4 text-5xl font-bold tracking-tight sm:text-6xl">Summit-proven<br class="hidden sm:block" /> favourites.</h2>
    </div>
    <a href="#products" class="inline-flex items-center gap-2 rounded-full border border-white/10 px-5 py-3 text-sm font-semibold text-stone-300 transition hover:border-white/30 hover:text-white">View all products <span aria-hidden="true">→</span></a>
  </div>
  <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {products.map((p) => (
      <article class="group flex flex-col rounded-[2rem] border border-white/10 bg-white/[0.03] p-2 transition duration-500 hover:-translate-y-1.5 hover:border-amber-400/30 hover:bg-white/[0.05]">
        <div class="relative aspect-[4/3] overflow-hidden rounded-[1.6rem] bg-stone-900">
          <img src={p.img} alt={p.title} loading="lazy" decoding="async" class="size-full object-cover transition duration-700 group-hover:scale-105" />
          <div class="absolute inset-x-3 top-3 flex items-center justify-between">
            <span class="rounded-full bg-stone-950/60 px-3 py-1.5 text-xs font-semibold backdrop-blur-md">{p.tag}</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1.5 text-xs font-bold text-stone-950 backdrop-blur-md">★ {p.rating}</span>
          </div>
          <a href={`/product/${p.id}`} class="absolute bottom-3 right-3 grid size-11 translate-y-2 place-items-center rounded-full bg-white text-stone-950 opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100" aria-label={`View ${p.title} details`}>↗</a>
        </div>
        <div class="flex flex-1 flex-col px-4 pb-4 pt-5">
          <div class="flex items-start justify-between gap-4">
            <h3 class="font-display text-xl font-semibold leading-tight">{p.title}</h3>
            <p class="font-display text-2xl font-bold">${p.price}</p>
          </div>
          <p class="mt-2 text-sm text-stone-500">{p.reviews} reviews · Rent from <span class="text-amber-400">${p.rental}/day</span></p>
          <div class="mt-auto grid grid-cols-[auto_1fr] gap-2 pt-6">
            <a href={`/product/${p.id}`} class="inline-flex items-center justify-center rounded-full border border-white/10 px-5 py-3 text-sm font-semibold text-stone-200 transition hover:border-white/30">Details</a>
            <button type="button" data-add-to-cart={p.id} data-product-title={p.title} data-product-price={String(p.price)} data-product-image={p.img} class="add-btn inline-flex items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-stone-950 transition hover:bg-amber-300 active:scale-95">
              <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
              <span>Add to Cart</span>
            </button>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>