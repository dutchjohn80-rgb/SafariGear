---
const { packages } = Astro.props;
---
<section id="planner" class="mx-auto max-w-7xl scroll-mt-28 px-5 pb-28">
  <div class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-stone-900/50 p-6 md:p-12">
    <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(ellipse_at_top_left,black,transparent_70%)]"></div>
    <div aria-hidden="true" class="absolute -left-32 -top-32 size-96 rounded-full bg-amber-500/20 blur-[100px]"></div>
    <div class="relative grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-400">Rental planner</p>
        <h2 class="font-display mt-4 text-5xl font-bold tracking-tight">Build your climb kit in seconds.</h2>
        <p class="mt-4 max-w-md text-stone-400">Pick your mountain and trek length. We'll recommend a complete gear package, fitted and delivered to your hotel.</p>

        <form id="planner-form" class="mt-10 space-y-8">
          <fieldset>
            <legend class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">01 · Destination</legend>
            <div class="grid grid-cols-2 gap-3">
              {[{ v: 'kili', l: 'Kilimanjaro', h: '5,895 m' }, { v: 'meru', l: 'Mt. Meru', h: '4,566 m' }].map((m, i) => (
                <label class="group cursor-pointer rounded-3xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-white/20 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-400/10 has-[:checked]:shadow-[0_0_0_4px_rgba(251,191,36,0.1)]">
                  <input type="radio" name="mountain" value={m.v} checked={i === 0} class="sr-only" />
                  <svg aria-hidden="true" class="mb-4 size-6 text-stone-600 transition group-has-[:checked]:text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M2 20 9.5 7l3.5 6 2-3.5L22 20z"/></svg>
                  <span class="font-display block text-lg font-bold">{m.l}</span>
                  <span class="font-mono text-xs text-stone-500">{m.h}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div>
            <label for="days" class="mb-4 flex items-baseline justify-between text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">
              02 · Duration <output id="days-out" class="font-display text-2xl normal-case tracking-normal text-amber-400">7 days</output>
            </label>
            <input id="days" name="days" type="range" min="3" max="9" value="7" class="h-2 w-full cursor-pointer appearance-none rounded-full bg-white/10 accent-amber-400" />
            <div class="mt-2 flex justify-between font-mono text-[10px] text-stone-600"><span>3d</span><span>9d</span></div>
          </div>
        </form>
      </div>

      <div id="planner-result" aria-live="polite" class="flex flex-col rounded-[2rem] border border-white/10 bg-stone-950/80 p-7 shadow-2xl shadow-black/40 backdrop-blur-xl">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-500">Recommended</p>
            <h3 id="pkg-name" class="font-display mt-2 text-3xl font-bold">{packages.kili.name}</h3>
          </div>
          <span id="pkg-route" class="rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1.5 text-xs font-semibold text-amber-300">{packages.kili.route}</span>
        </div>
        <ul id="pkg-items" class="mt-6 flex-1 space-y-3 text-sm text-stone-300"></ul>
        <div class="mt-6 flex items-end justify-between gap-4 rounded-3xl bg-white/[0.04] p-5">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-stone-500">Package total</p>
            <p class="font-display mt-1 text-4xl font-bold"><span id="pkg-price">$0</span></p>
          </div>
          <button id="reserve-package-button" type="button" class="rounded-full bg-amber-400 px-6 py-3.5 text-sm font-semibold text-stone-950 transition hover:bg-amber-300">Reserve package →</button>
        </div>
      </div>
    </div>
  </div>
</section>