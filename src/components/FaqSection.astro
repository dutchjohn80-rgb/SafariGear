<section class="mx-auto grid max-w-7xl gap-12 px-5 pb-28 lg:grid-cols-[1fr_1.6fr]">
  <div class="lg:sticky lg:top-28 lg:self-start">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-400">FAQ</p>
    <h2 class="font-display mt-4 text-5xl font-bold tracking-tight">Everything you need before the climb.</h2>
    <p class="mt-4 text-stone-400">Still unsure? Our gear specialists reply within the hour.</p>
    <a href="#contact" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-white underline decoration-amber-400 decoration-2 underline-offset-8 hover:text-amber-300">Talk to a specialist →</a>
  </div>

  <div class="divide-y divide-white/10 border-y border-white/10">
    {[
      { q: 'Do you offer hotel delivery in Arusha?', a: 'Yes. We deliver directly to your Arusha hotel or lodge within 24 hours after booking confirmation.' },
      { q: 'Can I rent gear instead of buying it?', a: 'Absolutely. We offer expedition rental packages with cleaning, repacking, and route-specific setup support.' },
      { q: 'How do you recommend the right gear?', a: 'Tell us your route, trekking dates, and experience level, and our gear specialists tailor a package to your climb.' },
      { q: 'Is there support for first-time climbers?', a: 'Yes. We include checklist guidance, altitude-specific recommendations, and support for beginner alpine planning.' },
    ].map((item, i) => (
      <details class="group py-6" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center gap-6 [&::-webkit-details-marker]:hidden">
          <span class="font-mono text-sm text-stone-600">0{i + 1}</span>
          <span class="font-display flex-1 text-xl font-semibold text-stone-100 transition group-hover:text-amber-300">{item.q}</span>
          <span aria-hidden="true" class="grid size-10 shrink-0 place-items-center rounded-full border border-white/10 text-xl text-amber-400 transition duration-300 group-open:rotate-45 group-open:border-amber-400 group-open:bg-amber-400 group-open:text-stone-950">+</span>
        </summary>
        <p class="mt-4 max-w-xl pl-12 leading-7 text-stone-400">{item.a}</p>
      </details>
    ))}
  </div>
</section>